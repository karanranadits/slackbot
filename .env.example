# ─────────────────────────────────────────────────────────────────────────────
# DSR Slack Bot — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Slack App Credentials (from api.slack.com > Your App)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Required for Socket Mode (WebSocket — no public URL needed)
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Your own Slack User ID (used to auto-seed your account on first startup)
SLACK_USER_ID=U0XXXXXXXXX

# The Slack channel ID of the group DSR channel (e.g. C0XXXXXXXXX)
# The bot posts 8 PM reminders here and announces new user registrations.
SLACK_DSR_CHANNEL_ID=C0XXXXXXXXX

# ── AI Provider ───────────────────────────────────────────────────────────────
# Choose: gemini | openai | claude
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# API Keys (only the one matching AI_PROVIDER is required)
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Groq — free Whisper API for voice note transcription (openai/claude providers)
GROQ_API_KEY=your-groq-api-key-here

# ── Office Portal (primary/admin user) ────────────────────────────────────────
# These credentials are used to:
#   1. Fetch the shared list of DSR categories and projects at startup
#   2. Auto-register the primary user (SLACK_USER_ID) so they skip onboarding
# Additional users register themselves via the bot's DM onboarding flow.
PORTAL_EMAIL=you@yourcompany.com
PORTAL_PASSWORD=your-portal-password-here
PORTAL_BASE_URL=https://portal-api.example.com

# Optional: friendly display name for the primary user (defaults to email prefix)
PORTAL_DISPLAY_NAME=Your Name

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── FastAPI Server ─────────────────────────────────────────────────────────────
# Start with:  uvicorn main:app --host 0.0.0.0 --port 3000 --reload
# Or simply:   ./start.sh
#
# Slack events are received via Socket Mode (WebSocket) — NO public URL needed.
# FastAPI only serves the management REST API (health, users, history).
# API docs available at: http://localhost:3000/docs
